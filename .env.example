# ==============================================================================
# AUDESP FASE IV - VARIÁVEIS DE AMBIENTE
# ==============================================================================

# ==============================================================================
# 1. PORTAS DOS SERVIÇOS (HOST E CONTÊINER IGUAIS)
# ==============================================================================
# O sistema e o Docker foram projetados para que a porta no host e dentro
# do contêiner sejam sempre idênticas. Se alterar DB_PORT para 3304,
# o MySQL rodará na 3304 tanto internamente quanto externamente.
DB_PORT=3306
BACKEND_PORT=8000
FRONTEND_PORT=80

# ==============================================================================
# 2. BANCO DE DADOS MYSQL
# ==============================================================================
# OPÇÃO A: Usando Banco Próprio / Servidor Interno (ex: 10.0.20.70)
#   - Preencha o IP/Host e credenciais.
#   - Execute: docker compose up -d (o contêiner do MySQL NÃO será iniciado).
#
# OPÇÃO B: Subindo o MySQL no Docker
#   - Defina DB_HOST=db (se backend rodar no Docker) ou DB_HOST=127.0.0.1 (se local).
#   - Execute: docker compose --profile db up -d
DB_CONNECTION=mysql
DB_HOST=10.0.20.70
DB_DATABASE=AUDESP_FASE_4
DB_USERNAME=root
DB_PASSWORD="bancodesenv"

# ==============================================================================
# 3. AUDESP (TCESP) - API URL
# ==============================================================================
# Testes/Piloto: https://audesp-piloto.tce.sp.gov.br
# Produção/Oficial: https://audesp.tce.sp.gov.br
AUDESP_API_URL=https://audesp-piloto.tce.sp.gov.br

# ==============================================================================
# 4. FRONTEND (URL DE ACESSO À API)
# ==============================================================================
# URL base que o navegador do cliente usará para se comunicar com o backend
VITE_API_URL=http://localhost:8000


